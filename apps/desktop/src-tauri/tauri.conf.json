{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMuse",
  "version": "0.1.0",
  "identifier": "ai.copilotkit.openmuse",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMuse",
        "width": 1180,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Run OpenMuse without a terminal",
    "longDescription": "Start, stop and monitor a local OpenMuse deployment. The web UI does the work; this app manages the stack."
  }
}
