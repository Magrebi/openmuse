{
  "name": "@openmuse/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json && cp ui/index.html ui/app.css dist/",
    "icons": "node scripts/make-icons.mjs",
    "tauri": "tauri",
    "tauri:build": "pnpm build && tauri build",
    "tauri:dev": "pnpm build && tauri dev"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
